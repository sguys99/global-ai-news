# 실제 값은 .env.local 에 입력한다 (git에 커밋하지 않음).
# 공개 페이지 빌드에는 키가 필요 없다. 아래 키는 수집(npm run collect)과 로컬 admin 전용이다.

# --- LLM ---
# Anthropic Claude API key
ANTHROPIC_API_KEY=
# 선별·가공에 사용할 모델 (기본: Haiku)
LLM_MODEL=claude-haiku-4-5

# --- 수집 소스 인증 ---
# Reddit OAuth2 (client_credentials). 어댑터만 남아 있고 지금 등록된 Reddit 소스는 없다.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# arXiv "유명 논문" 게이트 보강 (선택). 둘 다 없어도 동작하나 정확도/한도가 떨어진다.
# Semantic Scholar 인용수 조회 키 — 미설정 시 무키 공용 풀(429 잦음)로 폴백.
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex polite-pool 식별 이메일 (기관 조회 시 권장).
OPENALEX_MAILTO=

# --- LLM 선별·가공 / 비용 가드 ---
# 1회 실행당 게재(가공) 상한. LLM 이 후보 중 이 수 이하로 골라 한국어로 가공한다 (기본 35).
MAX_PICKS_PER_RUN=35
# LLM 선별에 보내는 후보 수 상한 — 소스별 라운드로빈으로 채운다 (기본 180).
TRIAGE_POOL_SIZE=180
# 1회 실행 LLM 비용 상한(USD). 예상 비용이 넘는 가공 요청은 보내지 않는다 (기본 0.1).
MAX_COST_USD_PER_RUN=0.1
# Message Batches API 사용(50% 할인, 보통 수 분 소요). 즉시 결과가 필요하면 0 (기본 1).
LLM_USE_BATCH=1
# 배치 대기 상한(분). 넘으면 취소하고 남은 요청을 일반 호출로 보낸다 (기본 25).
BATCH_TIMEOUT_MIN=25

# --- Admin 운영 콘솔 (로컬 next dev 전용) ---
# GitHub: sources.json 커밋 / workflow_dispatch 트리거용 PAT.
# 수집의 GitHub Search·저장소 조회 인증에도 쓰여 rate limit(30/분)이 완화된다(선택).
GITHUB_PAT=
# 대상 저장소 (owner/repo)
GITHUB_REPO=
# 커밋/워크플로 대상 브랜치 (기본: deploy/github-pages)
GITHUB_BRANCH=deploy/github-pages
# 운영자 로그인 비밀번호. 미설정 시 /admin 접근/로그인 불가.
# (Admin 세션 쿠키 HMAC 서명 키로도 사용됨)
ADMIN_PASSWORD=

