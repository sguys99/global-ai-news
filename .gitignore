# data artifacts (keep folder structure, ignore contents)
/data/raw/*
/data/intermediate/*
/data/processed/*
!/data/**/.gitkeep

# SQLite DB: app.db는 빌드 시 readonly 조회용으로 git에 포함(커밋).
# WAL/SHM은 실행 중에만 생기는 임시 파일이므로 무시.
/data/app.db-wal
/data/app.db-shm

# 분야 재분류(scripts/reclassify.ts): --apply 직전 백업과 LLM 결과 캐시(로컬 전용).
/data/app.db.bak-*
/data/reclassify-cache.json

# 수집 평가 실행(collect --no-save) 스냅숏과 선별 비교 결과(로컬 전용).
/data/eval/

# 주간 SNS 키트(scripts/social-weekly.ts — posts.md·카드 PNG, 사람이 검토해 손으로 올린다, 로컬 전용).
/data/social/

# HTML 회귀 비교(scripts/html-regress.ts) 정적 export 산출물·기준선 스냅숏(로컬 전용, 수백 MB).
/data/regress/

